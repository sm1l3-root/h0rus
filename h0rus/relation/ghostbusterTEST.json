  "test_cases": {
    "TC-01": {
      "description": "Standard Web Server (Arkası Dolu - DB ve Auth Ghost Node Bekleniyor)",
      "visible_node": {
        "ip": "10.154.142.50",
        "port_role": "Web_Server",
        "dns_role": "Web_Server",
        "open_ports": [80, 443, 8080],
        "ttl": 128,
        "connected_before": ["10.154.142.182"],
        "connected_after": []
      },
      "expected_ghosts": [
        {
          "role_name": "Database_Server",
          "relationship": "DATA_PERSISTENCE",
          "criticality": "HIGH"
        },
        {
          "role_name": "Internal_DNS_Server",
          "relationship": "NAME_RESOLUTION",
          "criticality": "HIGH"
        }
      ]
    },
